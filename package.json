{
  "name": "lexpertise-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio web de LEXPERTISE — servicios jurídicos en Colombia",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-contenido.mjs --si-produccion",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:contenido": "node scripts/check-contenido.mjs",
    "test:enlaces": "node scripts/test-enlaces.mjs",
    "test:formularios": "node scripts/test-formularios.mjs",
    "test": "npm run typecheck && npm run test:enlaces && npm run test:formularios",
    "cms": "npx decap-server"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
