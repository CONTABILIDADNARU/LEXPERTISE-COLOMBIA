# ─── Entorno ──────────────────────────────────────────────────────────────
# development | staging | production. Fuera de "production" el sitio es noindex y muestra marcadores PENDIENTE.
NEXT_PUBLIC_SITE_ENV=staging
# URL pública sin barra final (canonical, sitemap, Open Graph, verificación de origen de formularios).
# En Vercel, si se deja vacía, se usa la URL del despliegue (NEXT_PUBLIC_VERCEL_URL).
NEXT_PUBLIC_SITE_URL=https://staging.ejemplo.com

# ─── Almacenamiento de solicitudes (obligatorio fuera de desarrollo) ────────
# file: archivo JSONL en disco (solo servidores con disco persistente). supabase: recomendado en Vercel.
LEAD_STORE=supabase
LEADS_DIR=
SUPABASE_URL=
# Clave publicable (sb_publishable_…): basta, porque la tabla solo se escribe mediante funciones protegidas.
SUPABASE_KEY=
# Secreto del servidor que exigen las funciones lx_* (en la base se guarda solo su hash SHA-256).
# Generar con: openssl rand -hex 32. SOLO en el servidor, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_RPC_SECRET=

# ─── CRM (webhook firmado HMAC-SHA256) ───────────────────────────────────
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── Límite de envíos global (opcional, recomendado en Vercel) ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Medición (se cargan solo con consentimiento) ────────────────────────
# Usar GTM o GA4 directo, no ambos para el mismo flujo.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── API de Conversiones de Meta (servidor, opcional) ─────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ─── Panel de contenidos (Decap CMS con GitHub) ──────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
